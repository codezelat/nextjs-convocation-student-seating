{
  "name": "sitc-convocation-student-seating",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:generate:mysql": "prisma generate --schema prisma/schema.mysql.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:migrate:postgres": "node --env-file-if-exists=.env.production node_modules/prisma/build/index.js migrate deploy --schema prisma/postgres/schema.prisma",
    "db:push:mysql": "prisma db push --schema prisma/schema.mysql.prisma",
    "db:setup": "tsx -r tsconfig-paths/register scripts/setup-db.ts && prisma generate && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "build:mysql": "prisma generate --schema prisma/schema.mysql.prisma && next build",
    "build:postgres": "npm run db:generate:postgres && next build",
    "import:seats": "tsx -r tsconfig-paths/register scripts/import-workbook.ts",
    "db:backfill": "tsx -r tsconfig-paths/register scripts/backfill-seat-status.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.22.5"
    },
    "postcss": "^8.5.33",
    "uuid": "^11.1.1"
  }
}
