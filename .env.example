DATABASE_URL="file:./dev.db"
# Postgres only: use the pooled URL for the app and the direct URL for migrations.
# DATABASE_URL_POOLED="postgresql://user:password@pooler-host/db?sslmode=require&sslaccept=strict"
# DATABASE_URL_DIRECT="postgresql://user:password@direct-host/db?sslmode=require&sslaccept=strict"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Set this to the final HTTPS production domain before building/deploying.
# It is used for canonical URLs, Open Graph/Twitter cards, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Private S3-compatible bucket used for certificate payment receipts.
# RECEIPT_STORAGE_PROVIDER="B2"
B2_S3_ENDPOINT="https://s3.your-region.backblazeb2.com"
B2_REGION="your-region"
B2_BUCKET_NAME="your-private-bucket"
B2_KEY_ID="your-bucket-scoped-key-id"
B2_APPLICATION_KEY="your-bucket-scoped-application-key"

# Cloudflare R2 production alternative. Keep public access disabled.
# RECEIPT_STORAGE_PROVIDER="R2"
# R2_S3_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
# R2_BUCKET_NAME="sitc-convocation-certificate-receipts"
# R2_KEY_ID="your-bucket-scoped-access-key"
# R2_SECRET_ACCESS_KEY="your-bucket-scoped-secret-key"
